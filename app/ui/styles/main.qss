/* Main Qt Stylesheet for SafePy Application */

/* ============== Color Scheme ============== */
/* Primary: #0099CC (Blue)
   Background: #E8F4F8 (Light Blue)
   White: #FFFFFF
   Text: #333333
   Error: #CC0000 (Red)
   Success: #00AA00 (Green)
   Border: #CCCCCC (Light Gray)
*/

/* ============== Main Window ============== */
QMainWindow {
    background-color: #FFFFFF;
}

/* ============== Status Bar ============== */
QStatusBar {
    background-color: #E8F4F8;
    color: #333333;
    border-top: 1px solid #CCCCCC;
    padding: 5px;
}

/* ============== Buttons ============== */
QPushButton {
    background-color: #FFFFFF;
    color: #0099CC;
    border: 2px solid #0099CC;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 11pt;
}

QPushButton:hover {
    background-color: #E8F4F8;
    border: 2px solid #0077AA;
}

QPushButton:pressed {
    background-color: #D0E8F0;
    border: 2px solid #005588;
}

QPushButton:disabled {
    color: #999999;
    border: 2px solid #CCCCCC;
}

/* ============== Labels ============== */
QLabel {
    color: #333333;
}

/* ============== Input Fields ============== */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px;
    color: #333333;
    selection-background-color: #0099CC;
}

QLineEdit:focus {
    border: 2px solid #0099CC;
}

QLineEdit:disabled {
    background-color: #F5F5F5;
    color: #999999;
}

/* ============== Tables ============== */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F5F5F5;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    gridline-color: #EEEEEE;
}

QTableWidget::item {
    padding: 5px;
    color: #333333;
}

QTableWidget::item:selected {
    background-color: #0099CC;
    color: #FFFFFF;
}

QTableWidget::item:hover {
    background-color: #E8F4F8;
}

QHeaderView::section {
    background-color: #E8F4F8;
    color: #333333;
    padding: 8px;
    border: 1px solid #CCCCCC;
    font-weight: bold;
}

/* ============== Frames ============== */
QFrame {
    border-radius: 4px;
}

/* ============== Dialogs ============== */
QDialog {
    background-color: #FFFFFF;
}

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #333333;
}

QMessageBox QPushButton {
    min-width: 70px;
}

/* ============== File Dialog ============== */
QFileDialog {
    background-color: #FFFFFF;
}

/* ============== Scroll Area ============== */
QScrollArea {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}

QScrollBar:vertical {
    background-color: #F5F5F5;
    width: 12px;
    border: 1px solid #CCCCCC;
}

QScrollBar::handle:vertical {
    background-color: #0099CC;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0077AA;
}

QScrollBar:horizontal {
    background-color: #F5F5F5;
    height: 12px;
    border: 1px solid #CCCCCC;
}

QScrollBar::handle:horizontal {
    background-color: #0099CC;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0077AA;
}

/* ============== Text Edit ============== */
QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px;
    color: #333333;
}

QTextEdit:focus {
    border: 2px solid #0099CC;
}

/* ============== Combo Box ============== */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px;
    color: #333333;
}

QComboBox:focus {
    border: 2px solid #0099CC;
}

QComboBox::drop-down {
    border-left: 1px solid #CCCCCC;
    background-color: #E8F4F8;
}

/* ============== Specific Overrides ============== */
/* Summary cards */
.SummaryCard {
    background-color: #F5F5F5;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
}

/* Drop area for file upload */
.DropArea {
    border: 2px dashed #0099CC;
    border-radius: 8px;
    background-color: #E8F4F8;
}

.DropArea:hover {
    background-color: #D0E8F0;
    border: 2px solid #0099CC;
}
